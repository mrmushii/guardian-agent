# Guardian Agent — server-side secrets. Copy to .env and fill in. Never commit .env.
# None of these may be exposed via NEXT_PUBLIC_* variables.

# --- Networks (architecture §2: Alchemy or QuickNode) ---
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_WS_URL=
BASE_MAINNET_RPC_URL=
BASE_MAINNET_WS_URL=

# --- Bundler / paymaster (Pimlico proposed; provider choice confirmed in Gate 0) ---
BUNDLER_PROVIDER=pimlico
PIMLICO_API_KEY=
# Optional, only if ZeroDev is selected as bundler/paymaster instead
ZERODEV_PROJECT_ID=

# --- Test-only keys (Base Sepolia). Never put mainnet funds behind these. ---
# Master owner for Gate 0 scripts. In production the master key stays in the owner's wallet.
TESTNET_OWNER_PRIVATE_KEY=
# "Wallet B" that sends WETH during the demo
TESTNET_WALLET_B_PRIVATE_KEY=
# Funded EOA that submits EntryPoint.handleOps in the forced-failure harness (Defense C)
TESTNET_HARNESS_PRIVATE_KEY=

# --- Worker secrets ---
# 32-byte key (hex) used to encrypt stored session keys; generate with: openssl rand -hex 32
SESSION_KEY_ENCRYPTION_KEY=
SESSION_KEY_ENCRYPTION_KEY_VERSION=1

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (model IDs must be verified before use) ---
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Web auth (signed session cookie); generate with: openssl rand -hex 32 ---
AUTH_SECRET=
